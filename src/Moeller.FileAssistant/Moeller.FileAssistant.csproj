<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0-windows</TargetFramework>
  <EnableWindowsTargeting>true</EnableWindowsTargeting>
  <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
  <OutputType>WinExe</OutputType><ImplicitUsings>disable</ImplicitUsings>
  <AssemblyName>Moeller.FileAssistant</AssemblyName>
  <RootNamespace>Moeller.FileAssistant</RootNamespace>
  <ApplicationIcon Condition="Exists('App.ico')">App.ico</ApplicationIcon>
  <ApplicationManifest>app.manifest</ApplicationManifest>
 </PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="../Moeller.Core/Moeller.Core.csproj" />
  <Content Include="../../vendor/exiftool/**/*" Link="tools/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
 </ItemGroup>
</Project>
