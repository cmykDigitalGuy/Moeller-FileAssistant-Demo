<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0-windows</TargetFramework>
  <EnableWindowsTargeting>true</EnableWindowsTargeting>
  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  <IsPackable>false</IsPackable>
 </PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="../src/Moeller.FileAssistant/Moeller.FileAssistant.csproj" ReferenceOutputAssembly="false" />
 </ItemGroup>
 <Target Name="CreateWindowsSetup" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipInstallerBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
  <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\Package-Windows.ps1&quot;" />
 </Target>
</Project>
